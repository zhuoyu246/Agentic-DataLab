APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# DeepSeek is OpenAI-compatible. The backend uses the same client path as vLLM.
VLLM_BASE_URL=https://api.deepseek.com/v1
VLLM_MODEL=deepseek-chat
VLLM_API_KEY=sk-your-deepseek-key
VLLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_WINDOW_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=2048

MAX_AGENT_STEPS=12
MAX_REFLEXION_STEPS=2
SQL_REQUIRE_HITL=true
ALLOW_WRITE_SQL=false

REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=
CHECKPOINT_TTL_SECONDS=86400
DATA_ROOT=./storage
HOT_DATASET_MAX_MB=64
COLD_DATASET_FORMAT=parquet

MLFLOW_TRACKING_URI=sqlite:///./storage/mlflow.db
MLFLOW_ARTIFACT_ROOT=./storage/mlflow_artifacts
MLFLOW_EXPERIMENT_NAME=Agentic-DataLab
H2O_MAX_RUNTIME_SECONDS=60
H2O_OUTER_TIMEOUT_SECONDS=90
H2O_MAX_MODELS=8
